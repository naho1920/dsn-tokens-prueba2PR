{
  "radius-none": {
    "$type": "dimension",
    "$value": "0px"
  },
  "radius-xs": {
    "$type": "dimension",
    "$value": "4px"
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": "6px"
  },
  "radius-md": {
    "$type": "dimension",
    "$value": "8px"
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": "12px"
  },
  "radius-xl": {
    "$type": "dimension",
    "$value": "16px"
  },
  "radius-2xl": {
    "$type": "dimension",
    "$value": "24px"
  },
  "radius-3xl": {
    "$type": "dimension",
    "$value": "32px"
  },
  "radius-full": {
    "$type": "dimension",
    "$value": "9999px"
  },
  "radius-control": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "radius-control-small": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "radius-container": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "radius-pill": {
    "$type": "dimension",
    "$value": "{radius-full}"
  }
}
