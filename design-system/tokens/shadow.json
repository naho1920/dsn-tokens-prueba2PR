{
  "shadow-sm": {
    "$type": "shadow",
    "$value": "0px 1px 2px 0px rgba(0,0,0,0.05)"
  },
  "shadow-base": {
    "$type": "shadow",
    "$value": "0px 2px 4px 0px rgba(0,0,0,0.07)"
  },
  "shadow-md": {
    "$type": "shadow",
    "$value": "0px 4px 8px -1px rgba(0,0,0,0.1)"
  },
  "shadow-lg": {
    "$type": "shadow",
    "$value": "0px 8px 16px -2px rgba(0,0,0,0.1)"
  },
  "shadow-xl": {
    "$type": "shadow",
    "$value": "0px 16px 24px -4px rgba(0,0,0,0.1)"
  },
  "shadow-2xl": {
    "$type": "shadow",
    "$value": "0px 24px 48px -6px rgba(0,0,0,0.15)"
  },
  "shadow-inner": {
    "$type": "shadow",
    "$value": "inset 0px 2px 4px 0px rgba(0,0,0,0.06)"
  },
  "shadow-raised": {
    "$type": "shadow",
    "$value": "{shadow-sm}"
  },
  "shadow-overlay": {
    "$type": "shadow",
    "$value": "{shadow-md}"
  },
  "shadow-modal": {
    "$type": "shadow",
    "$value": "{shadow-xl}"
  }
}
